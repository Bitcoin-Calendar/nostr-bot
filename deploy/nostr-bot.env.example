# Install as /etc/bitcal/nostr-bot.env, root:root, mode 0600.
BOT_API_ENDPOINT=http://127.0.0.1:3000/api
BOT_API_KEY=
NOSTR_PRIVATE_KEY_EN=
NOSTR_RELAYS=wss://relay.primal.net,wss://relay.damus.io,wss://nos.lol,wss://relay.snort.social
WEB_BASE_URL=https://bitcoin-calendar.org
BOT_STATE_DIR=/var/lib/bitcal-nostr
BOT_TIMEZONE=America/New_York
BOT_START_DATE=2026-10-03
BOT_SLEEP_SECONDS=1800
